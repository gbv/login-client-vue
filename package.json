{
  "name": "gbv-login-client-vue",
  "version": "0.3.0",
  "files": ["dist"],
  "type": "module",
  "main": "./dist/gbv-login-client-vue.cjs",
  "module": "./dist/gbv-login-client-vue.js",
  "exports": {
    ".": {
      "import": "./dist/gbv-login-client-vue.js",
      "require": "./dist/gbv-login-client-vue.cjs"
    },
    "./login": {
      "import": "./dist/login.js",
      "require": "./dist/login.cjs"
    },
    "./user-status": {
      "import": "./dist/user-status.js",
      "require": "./dist/user-status.cjs"
    },
    "./style": "./dist/style.css"
  },
  "sideEffects": false,
  "scripts": {
    "test": "mocha --recursive",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint",
    "fix": "eslint --fix",
    "lint-staged": "lint-staged",
    "yesno": "node -e \"const yesno = require('yesno'); yesno({ question: 'Are you sure you want to continue?' }).then(ok => process.exit(ok ? 0 : 1));\"",
    "release": "test $(git rev-parse --abbrev-ref HEAD) = dev && git pull && npm test && npm run build && npm version $SEMVER && npm run --silent yesno && (git push && git checkout main && git merge dev && git push --follow-tags && git checkout dev) || (git tag -d $(git describe --tags) && git reset --hard HEAD~1)",
    "release:patch": "SEMVER=patch npm run release",
    "release:minor": "SEMVER=minor npm run release",
    "release:major": "SEMVER=major npm run release"
  },
  "lint-staged": {
    "**/*.{js,vue}": [
      "eslint --fix"
    ]
  },
  "pre-commit": [
    "lint-staged",
    "test"
  ],
  "dependencies": {
    "gbv-login-client": "^2.0.1",
    "jskos-tools": "^1.0.42",
    "vue": "^3.5.10"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/compiler-sfc": "^3.5.10",
    "eslint": "~9.11",
    "eslint-config-gbv": "~2.1",
    "lint-staged": "^15.2.10",
    "mocha": "^10.7.3",
    "mocha-eslint": "^7.0.0",
    "pre-commit": "^1.2.2",
    "vite": "^5.4.8",
    "yesno": "^0.4.0"
  },
  "author": "Stefan Peters <stefan.peters@gbv.de>",
  "license": "MIT",
  "description": "Vue 3 wrapper for login-client",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gbv/login-client-vue.git"
  }
}
